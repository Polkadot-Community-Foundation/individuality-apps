/**
 * Refreshes the signed Trinity stack descriptor copies that
 * packages/jollity-protocol keeps for the hosted networks, and regenerates the
 * plain values the app and the chat import from them.
 *
 *   npm run jollity:stacks            fetch, verify, rewrite the copies that moved, regenerate
 *   npm run jollity:stacks -- --check fetch and verify only; exit 2 when a copy or the generated module is behind
 *
 * Each live descriptor is verified against the key its link pins before it is
 * written, must still name the network's id and tld and carry every value the
 * app reads (`readHostedStack`), and may not lower `sequence`. A network with
 * no copy yet (a first run for a new network) gets one. A network that fails
 * is left as it was and the run exits 1. Exit 2 means a file changed (or, with
 * --check, would), so a scheduled job can open a pull request from the diff.
 * Run it when a network resets: its link, key and genesis change with it.
 */

import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { isDeepStrictEqual } from "node:util";
import { decodeLink, fetchDescriptor, open } from "@parity/trinity-stack";
import {
  STACK_EXPECTED,
  STACK_FILES,
  STACK_LINKS,
  decodePayload,
  readHostedStack,
  type HostedStack,
  type StackNetwork,
} from "../packages/jollity-protocol/src/stacks.ts";

const SRC = resolve(import.meta.dirname, "../packages/jollity-protocol/src");
const GENERATED = resolve(SRC, "stacks.generated.ts");
const networks = Object.keys(STACK_LINKS) as StackNetwork[];

const sequenceOf = (envelope: unknown): number => decodePayload(envelope).sequence as number;
const copyPath = (network: StackNetwork) => resolve(SRC, "stacks", STACK_FILES[network]);

/** The generated module's text for the copies on disk. */
function renderGenerated(): string {
  const stacks = {} as Record<StackNetwork, HostedStack>;
  for (const network of networks) {
    stacks[network] = readHostedStack(JSON.parse(readFileSync(copyPath(network), "utf8")), STACK_EXPECTED[network]);
  }
  return `// Generated by scripts/trinity-stacks.mts (npm run jollity:stacks) from the signed copies in ./stacks/.
// Do not edit: stacks.test.ts fails when it differs from what the copies decode to.

import type { HostedStack, StackNetwork } from "./stacks"

/** What each hosted network's descriptor gives the app, as plain values. */
export const HOSTED_STACKS: Record<StackNetwork, HostedStack> = ${JSON.stringify(stacks, null, 2)}
`;
}

const check = process.argv.includes("--check");
let failed = false;
let changed = false;

for (const network of networks) {
  const path = copyPath(network);
  try {
    const pointer = decodeLink(STACK_LINKS[network]);
    const bytes = await fetchDescriptor(pointer.url);
    if (bytes === undefined) throw new Error(`${pointer.url} is unreachable`);
    open(bytes, pointer); // throws on a bad signature or a rule of the RFC
    const text = new TextDecoder().decode(bytes);
    const envelope: unknown = JSON.parse(text);
    readHostedStack(envelope, STACK_EXPECTED[network]);
    const current: unknown = existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : undefined;
    if (current !== undefined && sequenceOf(envelope) < sequenceOf(current)) {
      throw new Error("the live descriptor's sequence is lower than the copy's");
    }
    if (isDeepStrictEqual(envelope, current)) {
      console.log(`${network}: up to date`);
      continue;
    }
    changed = true;
    if (!check) writeFileSync(path, text);
    console.log(`${network}: ${check ? "behind the live descriptor" : current === undefined ? "created" : "updated"}`);
  } catch (error) {
    failed = true;
    console.error(`${network}: left as it was: ${error instanceof Error ? error.message : String(error)}`);
  }
}

try {
  const generated = renderGenerated();
  if (!existsSync(GENERATED) || readFileSync(GENERATED, "utf8") !== generated) {
    changed = true;
    if (!check) writeFileSync(GENERATED, generated);
    console.log(`stacks.generated.ts: ${check ? "behind the copies" : "regenerated"}`);
  } else {
    console.log("stacks.generated.ts: up to date");
  }
} catch (error) {
  failed = true;
  console.error(`stacks.generated.ts: not written: ${error instanceof Error ? error.message : String(error)}`);
}

process.exit(failed ? 1 : changed ? 2 : 0);
